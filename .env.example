# Conexión a PostgreSQL
DATABASE_URL="postgresql://eticket:eticket@localhost:5432/eticket?schema=public"

# Secreto de Auth.js. Genera uno con: npx auth secret  (o: openssl rand -base64 32)
AUTH_SECRET="cambia-este-secreto"

# Necesario fuera de Vercel o detrás de un proxy
AUTH_TRUST_HOST=true

# Umbral (en porcentaje del plazo total) bajo el cual el SLA pasa a amarillo
SLA_UMBRAL_AMARILLO_PCT=25
